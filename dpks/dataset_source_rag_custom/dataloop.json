{
  "displayName": "Source Dataset",
  "name": "dataset-source-rag-custom",
  "description": "Empty source dataset for the Custom CLIP & Ollama RAG solution. Documents are ingested at runtime via a pipeline trigger.",
  "scope": "public",
  "version": "0.0.43",
  "codebase": {
    "type": "git",
    "gitUrl": "https://github.com/dataloop-ai-apps/data-management-demo-dataset.git",
    "gitTag": "0.0.43"
  },
  "attributes": {
    "Category": "Dataset",
    "Hub": "Dataloop",
    "Provider": "Dataloop",
    "Media Type": "Text",
    "License": "CC BY 4.0"
  },
  "metadata": {
    "system": {
      "systemCompute": true
    }
  },
  "components": {
    "computeConfigs": [
      {
        "name": "dataset-source-rag-custom-deploy",
        "secrets": [],
        "runtime": {
          "podType": "regular-m",
          "concurrency": 1,
          "runnerImage": "gcr.io/viewo-g/piper/agent/cpu/datasets-torch:0.0.1",
          "autoscaler": {
            "type": "rabbitmq",
            "minReplicas": 0,
            "maxReplicas": 2,
            "queueLength": 1000
          },
          "preemptible": false
        }
      }
    ],
    "modules": [
      {
        "name": "dataset-source-rag-custom-module",
        "entryPoint": "dpks/dataset_source_rag_custom/dataset_loader.py",
        "className": "DatasetExample",
        "description": "Empty source dataset module for the Custom CLIP & Ollama RAG solution",
        "initInputs": [],
        "functions": [
          {
            "name": "upload_dataset",
            "input": [
              {
                "type": "Dataset",
                "name": "dataset",
                "description": "Dataloop Dataset Entity"
              },
              {
                "type": "String",
                "name": "source",
                "description": "Dataset source URL"
              }
            ],
            "output": [],
            "displayName": "upload_dataset",
            "displayIcon": "",
            "description": "no-op (creates an empty dataset)"
          }
        ]
      }
    ],
    "datasets": [
      {
        "name": "Source Dataset",
        "docs": "https://github.com/dataloop-ai-apps/data-management-demo-dataset",
        "source": "",
        "invoke": {
          "namespace": "dataset-source-rag-custom-module.upload_dataset"
        },
        "computeConfig": "dataset-source-rag-custom-deploy"
      }
    ]
  }
}
