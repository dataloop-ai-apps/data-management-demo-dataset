{
  "displayName": "Retail Products Dataset",
  "name": "dataset-retail-products",
  "description": "A Retail Products Dataset, include images and embeddings, designed to introduce you to DDOE's robust Clustering capabilities.",
  "scope": "public",
  "version": "0.0.46",
  "codebase": {
    "type": "git",
    "gitUrl": "https://github.com/dataloop-ai-apps/data-management-demo-dataset.git",
    "gitTag": "0.0.46"
  },
  "attributes": {
    "Category": "Dataset",
    "Hub": "DDOE",
    "Provider": "DDOE",
    "Media Type": "Image"
  },
  "metadata": {
    "system": {
      "systemCompute": true
    }
  },
  "components": {
    "computeConfigs": [
      {
        "name": "dataset-retail-products-deploy",
        "secrets": [],
        "runtime": {
          "podType": "regular-m",
          "concurrency": 1,
          "runnerImage": "gcr.io/viewo-g/piper/agent/cpu/datasets-torch:0.0.4",
          "autoscaler": {
            "type": "rabbitmq",
            "minReplicas": 0,
            "maxReplicas": 2,
            "queueLength": 1000
          },
          "preemptible": false
        }
      }
    ],
    "modules": [
      {
        "name": "dataset-retail-products-module",
        "entryPoint": "dpks/retail_products/dataset_loader.py",
        "className": "DatasetExample",
        "description": "Dataset module for DDOE Onboarding Retail Products Dataset",
        "initInputs": [],
        "functions": [
          {
            "name": "upload_dataset",
            "input": [
              {
                "type": "Dataset",
                "name": "dataset",
                "description": "DDOE Dataset Entity"
              },
              {
                "type": "String",
                "name": "source",
                "description": "Dataset source URL"
              }
            ],
            "output": [],
            "displayName": "upload_dataset",
            "displayIcon": "",
            "description": "function to upload dataset to DDOE"
          }
        ]
      }
    ],
    "datasets": [
      {
        "name": "Retail Products Dataset",
        "docs": "https://github.com/dataloop-ai-apps/data-management-demo-dataset",
        "source": "https://github.com/dataloop-ai-apps/data-management-demo-dataset",
        "invoke": {
          "namespace": "dataset-retail-products-module.upload_dataset"
        },
        "computeConfig": "dataset-retail-products-deploy"
      }
    ]
  },
  "dependencies": [
    {
        "name": "clip-model-pretrained"
    },
    {
        "name": "resnet"
    }
]
}
