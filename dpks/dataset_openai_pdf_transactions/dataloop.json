{
  "displayName": "OpenAI Transactions PDF Dataset",
  "name": "dataset-openai-pdf-transactions",
  "description": "An OpenAI Transactions PDF Dataset designed to introduce you to Dataloop's robust RAG Pipeline capabilities.",
  "scope": "public",
  "version": "0.0.46",
  "codebase": {
    "type": "git",
    "gitUrl": "https://github.com/dataloop-ai-apps/data-management-demo-dataset.git",
    "gitTag": "0.0.46"
  },
  "attributes": {
    "Category": "Dataset",
    "Hub": "Dataloop",
    "Provider": "Dataloop",
    "Media Type": "Text"
  },
  "metadata": {
    "system": {
      "systemCompute": true
    }
  },
  "components": {
    "computeConfigs": [
      {
        "name": "dataset-pdf-transactions-deploy",
        "secrets": [],
        "runtime": {
          "podType": "regular-m",
          "concurrency": 1,
          "runnerImage": "gcr.io/viewo-g/piper/agent/cpu/datasets-torch:0.0.4",
          "autoscaler": {
            "type": "rabbitmq",
            "minReplicas": 0,
            "maxReplicas": 2,
            "queueLength": 1000
          },
          "preemptible": false
        }
      }
    ],
    "modules": [
      {
        "name": "dataset-pdf-transactions-module",
        "entryPoint": "dpks/dataset_openai_pdf_transactions/dataset_loader.py",
        "className": "DatasetExample",
        "description": "Dataset module for Dataloop Onboarding RAG Pipeline",
        "initInputs": [],
        "functions": [
          {
            "name": "upload_dataset",
            "input": [
              {
                "type": "Dataset",
                "name": "dataset",
                "description": "Dataloop Dataset Entity"
              },
              {
                "type": "String",
                "name": "source",
                "description": "Dataset source URL"
              }
            ],
            "output": [],
            "displayName": "upload_dataset",
            "displayIcon": "",
            "description": "function to upload dataset to Dataloop"
          }
        ]
      }
    ],
    "datasets": [
      {
        "name": "OpenAI Transactions PDF Dataset",
        "docs": "https://github.com/dataloop-ai-apps/data-management-demo-dataset",
        "source": "https://www.kaggle.com/datasets/ayoubcherguelaine/company-documents-dataset",
        "invoke": {
          "namespace": "dataset-pdf-transactions-module.upload_dataset"
        },
        "computeConfig": "dataset-pdf-transactions-deploy"
      }
    ]
  }
}
