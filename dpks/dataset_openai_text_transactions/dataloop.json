{
  "displayName": "OpenAI Transactions Text Dataset",
  "name": "dataset-openai-text-transactions",
  "description": "An OpenAI Transactions Text Dataset designed to introduce you to Dataloop's robust RAG Pipeline capabilities.",
  "scope": "public",
  "version": "0.0.33",
  "codebase": {
    "type": "git",
    "gitUrl": "https://github.com/dataloop-ai-apps/data-management-demo-dataset.git",
    "gitTag": "0.0.33"
  },
  "attributes": {
    "Category": "Dataset",
    "Hub": "Dataloop",
    "Provider": "Dataloop",
    "Media Type": "Text"
  },
  "metadata": {
    "system": {
      "systemCompute": true
    }
  },
  "components": {
    "computeConfigs": [
      {
        "name": "dataset-text-transactions-deploy",
        "secrets": [],
        "runtime": {
          "podType": "regular-m",
          "concurrency": 1,
          "runnerImage": "gcr.io/viewo-g/piper/agent/cpu/datasets-torch:0.0.1",
          "autoscaler": {
            "type": "rabbitmq",
            "minReplicas": 0,
            "maxReplicas": 2,
            "queueLength": 1000
          },
          "preemptible": false
        }
      }
    ],
    "modules": [
      {
        "name": "dataset-text-transactions-module",
        "entryPoint": "dpks/dataset_openai_text_transactions/dataset_loader.py",
        "className": "DatasetExample",
        "description": "Dataset module for Dataloop Onboarding RAG Pipeline",
        "initInputs": [],
        "functions": [
          {
            "name": "upload_dataset",
            "input": [
              {
                "type": "Dataset",
                "name": "dataset",
                "description": "Dataloop Dataset Entity"
              },
              {
                "type": "String",
                "name": "source",
                "description": "Dataset source URL"
              }
            ],
            "output": [],
            "displayName": "upload_dataset",
            "displayIcon": "",
            "description": "function to upload dataset to Dataloop"
          }
        ]
      }
    ],
    "datasets": [
      {
        "name": "OpenAI Transactions Text Dataset",
        "docs": "https://github.com/dataloop-ai-apps/data-management-demo-dataset",
        "source": "https://www.kaggle.com/datasets/ayoubcherguelaine/company-documents-dataset",
        "invoke": {
          "namespace": "dataset-text-transactions-module.upload_dataset"
        },
        "computeConfig": "dataset-text-transactions-deploy"
      }
    ]
  },
  "dependencies": [
    {
      "name": "text-embeddings-3",
      "components": {
        "models": [
          {
            "name": "openai-text-embeddings-3l"
          },
          {
            "name": "openai-prompt-embeddings-3l"
          }
        ]
      }
    }
  ]
}
