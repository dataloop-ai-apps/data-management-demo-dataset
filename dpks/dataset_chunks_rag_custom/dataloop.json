{
  "displayName": "Chunks Dataset",
  "name": "dataset-chunks-rag-custom",
  "description": "Empty chunks dataset for the Custom CLIP & Ollama RAG solution. Chunks and their CLIP embeddings are produced at runtime by the preprocess pipeline.",
  "scope": "public",
  "version": "0.0.43",
  "codebase": {
    "type": "git",
    "gitUrl": "https://github.com/dataloop-ai-apps/data-management-demo-dataset.git",
    "gitTag": "0.0.43"
  },
  "attributes": {
    "Category": "Dataset",
    "Hub": "Dataloop",
    "Provider": "Dataloop",
    "Media Type": "Text"
  },
  "metadata": {
    "system": {
      "systemCompute": true
    }
  },
  "components": {
    "computeConfigs": [
      {
        "name": "dataset-chunks-rag-custom-deploy",
        "secrets": [],
        "runtime": {
          "podType": "regular-m",
          "concurrency": 1,
          "runnerImage": "gcr.io/viewo-g/piper/agent/cpu/datasets-torch:0.0.1",
          "autoscaler": {
            "type": "rabbitmq",
            "minReplicas": 0,
            "maxReplicas": 2,
            "queueLength": 1000
          },
          "preemptible": false
        }
      }
    ],
    "modules": [
      {
        "name": "dataset-chunks-rag-custom-module",
        "entryPoint": "dpks/dataset_chunks_rag_custom/dataset_loader.py",
        "className": "DatasetExample",
        "description": "Empty chunks dataset module for the Custom CLIP & Ollama RAG solution",
        "initInputs": [],
        "functions": [
          {
            "name": "upload_dataset",
            "input": [
              {
                "type": "Dataset",
                "name": "dataset",
                "description": "Dataloop Dataset Entity"
              },
              {
                "type": "String",
                "name": "source",
                "description": "Dataset source URL"
              }
            ],
            "output": [],
            "displayName": "upload_dataset",
            "displayIcon": "",
            "description": "no-op (creates an empty dataset)"
          }
        ]
      }
    ],
    "datasets": [
      {
        "name": "Chunks Dataset",
        "docs": "https://github.com/dataloop-ai-apps/data-management-demo-dataset",
        "source": "",
        "invoke": {
          "namespace": "dataset-chunks-rag-custom-module.upload_dataset"
        },
        "computeConfig": "dataset-chunks-rag-custom-deploy"
      }
    ]
  },
  "dependencies": [
    {
      "name": "clip-model-pretrained"
    }
  ]
}
